# ==== Python（本仓库的 .venv 为临时分析环境，不属于项目） ====
.venv/
__pycache__/
*.pyc

# ==== Node / 前端构建产物 ====
node_modules/
dist/

# ==== Rust / Tauri 编译产物 ====
src-tauri/target/

# ==== IDE ====
.idea/
*.iml
# 注意：.vscode/ 不忽略——settings.json 与 extensions.json 需要团队共享
# 但其中的个人机器配置例外
.vscode/tasks.json

# ==== 操作系统 ====
Thumbs.db
Desktop.ini
.DS_Store

# ==== 日志与临时文件 ====
*.log
*.tmp

# ==== AI 助手本地记忆（工作会话数据，非项目源码） ====
.workbuddy/

# ==== Office 临时锁文件 ====
~$*

# ==== 表格 ====
# 默认忽略所有 xlsx（真实课程表含个人信息，一律不入库）
*.xlsx
# 例外：samples/ 下的**脱敏**样例是解析器的集成测试夹具，需要随仓库分发
!samples/*.xlsx
